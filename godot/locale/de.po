msgstr "Sammelt das Team und das Echo am Feuer …"

#: scripts/secret_night.gd
msgid "ECHO OF THE NIGHT · QUEST COMPLETE\nThe last echo burns away. You are home again.\n+%d Rem Dollars per player · Wave 5 in %d seconds"
msgstr "ECHO DER NACHT · AUFTRAG ERFÜLLT\nDas letzte Echo verglüht. Ihr seid wieder zu Hause.\n+%d Rem Dollars pro Spieler · Welle 5 in %d Sekunden"

#: scripts/secret_night.gd
msgid "DJ: %s! Run to the totem that flashes!"
msgstr "DJ: %s! Lauf zum Totem, das aufblitzt!"

#: scripts/secret_night.gd
msgid "DJ: Too slow, forest spirits! Once more from the top."
msgstr "DJ: Zu langsam, Waldgeister! Noch einmal von vorn."

#: scripts/secret_night.gd
msgid "SECRET NIGHT · OBERER SCHORCHEN"
msgstr "SECRET NACHT · OBERER SCHORCHEN"

#: scripts/secret_night.gd
