#: scripts/party_bar.gd
msgid "The bartender does not know that drink."
msgstr "Diesen Drink kennt der Barkeeper nicht."

#: scripts/pickup.gd
msgid "No Rem Dollars to drop."
msgstr "Keine Rem Dollars zum Abwerfen."

#: scripts/pickup.gd
msgid "Pick up the cash bundles on the ground first."
msgstr "Sammelt zuerst die Geldbündel am Boden auf."

#: scripts/pickup.gd
msgid "%d R dropped"
msgstr "%d R abgeworfen"

#: scripts/pickup.gd
msgid "Ammo: +%d %s"
msgstr "Munition: +%d %s"

#: scripts/pickup.gd
msgid "+1 grenade"
msgstr "+1 Granate"

#: scripts/pickup.gd
msgid "Bandage pack: +%d health"
msgstr "Verbandspäckli: +%d Leben"

#: scripts/pings.gd
msgid "%s is under attack!"
msgstr "%s wird angegriffen!"

#: scripts/pings.gd
msgid "%s is breaking!"
msgstr "%s bricht!"

#: scripts/pings.gd
msgid "%s breached! Fall back to the sandbags!"
msgstr "%s durchbrochen! Zurück zu den Sandsäcken!"

#: scripts/pings.gd
msgid "Hold %s!"
msgstr "Haltet %s!"

#: scripts/pings.gd
msgid "Hold the sandbag line behind %s!"
msgstr "Haltet die Sandsacklinie hinter %s!"

#: scripts/pings.gd
msgid "Defend the forest hut!"
msgstr "Verteidigt die Waldhütte!"

#: scripts/pings.gd
msgid "Enemy spotted here!"
msgstr "Gegner hier gesichtet!"

#: scripts/pings.gd
msgid "Move here!"
msgstr "Hierher!"

#: scripts/pings.gd
msgid "Regroup on me!"
msgstr "Sammeln bei mir!"

#: scripts/pings.gd
msgid "%s is down!"
msgstr "%s ist am Boden!"

#: scripts/pings.gd
msgid "%s was spotted by a screamer!"
msgstr "%s wurde von einem Kreischer entdeckt!"

#: scripts/pings.gd
msgid "Titan incoming!"
msgstr "Titan im Anmarsch!"

#: scripts/pings.gd
msgid "Blood moon! They are faster - kills count double."
msgstr "Blutmond! Sie sind schneller - Abschüsse zählen doppelt."

#: scripts/progression.gd
msgid "Mist Peddler"
msgstr "Nebelkrämer"

#: scripts/progression.gd
msgid "Wandering trader · Legendary rarities"
msgstr "Wanderhändler · Legendäre Raritäten"

#: scripts/progression.gd
msgid "Here today, among other trees tomorrow. What I bring rarely comes twice."
msgstr "Heute hier, morgen zwischen anderen Bäumen. Was ich mitbringe, kommt selten zweimal."

#: scripts/progression.gd
msgid "Mara"
msgstr "Mara"

#: scripts/progression.gd
msgid "Forester · Forest quests"
msgstr "Försterin · Waldaufträge"

#: scripts/progression.gd
msgid "Sit by the fire for a moment. The forest shelters us, but we have to look after it."
msgstr "Setz dich kurz ans Feuer. Der Wald gibt uns Schutz, aber wir müssen auf ihn aufpassen."

#: scripts/progression.gd
msgid "Vendor"
msgstr "Vendor"

#: scripts/progression.gd
msgid "Weapons & supplies"
msgstr "Waffen & Vorräte"

#: scripts/progression.gd
msgid "Stay alive. I trade with people who pull their weight."
msgstr "Bleib am Leben. Ich handle mit Leuten, die ihren Teil beitragen."

#: scripts/progression.gd
msgid "Mechanic"
msgstr "Mechanic"

#: scripts/progression.gd
msgid "Defense & training"
msgstr "Verteidigung & Training"

#: scripts/progression.gd
msgid "A barrier holds them up. A properly aimed sentinel does the rest."
msgstr "Eine Sperre hält sie auf. Ein richtig ausgerichteter Wächter erledigt den Rest."

#: scripts/progression.gd
msgid "Secret Vendor"
msgstr "Secret Vendor"

#: scripts/progression.gd
msgid "Rare equipment"
msgstr "Seltene Ausrüstung"

#: scripts/progression.gd
msgid "You found me. Now show me you can handle these weapons."
msgstr "Du hast mich gefunden. Jetzt zeig mir, dass du diese Waffen führen kannst."

#: scripts/progression.gd
msgid "Sturdy forest axe. Slow swing, heavy impact, no ammo."
msgstr "Kräftige Waldaxt. Langsamer Schlag, hohe Wucht, keine Munition."

#: scripts/progression.gd
msgid "Precise and economical. Six heavy rounds."
msgstr "Präzise und sparsam. Sechs schwere Schüsse."

#: scripts/progression.gd
msgid "Stops fast runners. High ammo consumption."
msgstr "Schnelle Läufer abfangen. Hoher Munitionsverbrauch."

#: scripts/progression.gd
msgid "Strong close-range defense. Weak at a distance."
msgstr "Starke Nahverteidigung. Auf Distanz wenig wirksam."

#: scripts/progression.gd
msgid "Versatile assault rifle with heavy recoil."
msgstr "Vielseitiges Sturmgewehr mit kräftigem Rückstoss."

#: scripts/progression.gd
msgid "Bolt-action rifle. Slow, precise and with strong penetration."
msgstr "Repetiergewehr. Langsam, präzise und durchschlagsstark."

#: scripts/progression.gd
msgid "60 rounds against the horde. Long reload."
msgstr "60 Schuss gegen die Horde. Lange Nachladepause."

#: scripts/progression.gd
msgid "Semi-automatic assault shotgun. Close range only."
msgstr "Halbautomatische Sturmschrotflinte. Nur für kurze Distanzen."

#: scripts/progression.gd
msgid "Titanbreaker .50. 75% bonus damage against titans, expensive ammo."
msgstr "Titanenbrecher .50. 75 % Zusatzschaden gegen Titanen, teure Munition."

#: scripts/progression.gd
msgid "Sets targets on fire and lights up the area for eight seconds. One shot per load."
msgstr "Setzt Getroffene in Brand und beleuchtet acht Sekunden lang das Gelände. Ein Schuss pro Ladung."

#: scripts/progression.gd
msgid "Heavy .50 pistol. Kills runners with one hit, but brutal recoil."
msgstr "Schwere .50-Pistole. Tötet Läufer mit einem Treffer, dafür brutaler Rückstoss."

#: scripts/progression.gd
msgid "Lever-action rifle with a 3x scope. Faster than the bolt-action rifle, long reload."
msgstr "Unterhebelrepetierer mit 3x-Zielfernrohr. Schneller als das Repetiergewehr, langes Nachladen."

#: scripts/progression.gd
msgid "40 rounds, barely any recoil, muffled report. Close range only, wide spread."
msgstr "40 Schuss, kaum Rückstoss, gedämpfter Knall. Nur auf kurze Distanz, weite Streuung."

#: scripts/progression.gd
msgid "Chills targets, freezes them and deals 40% more damage to frozen ones."
msgstr "Kühlt Getroffene herunter, friert sie ein und richtet an Gefrorenen 40 % mehr Schaden an."

#: scripts/progression.gd
msgid "Energy rifle with 5x optics. Overheats instead of reloading and cools itself down."
msgstr "Energiegewehr mit 5x-Optik. Überhitzt statt nachzuladen und kühlt sich selbst."

#: scripts/progression.gd
msgid "150-round belt, highest rate of fire in the camp. Very heavy, has to spin up, no scope."
msgstr "150 Schuss Gurt, höchste Feuerrate im Lager. Sehr schwer, läuft erst an, kein Zielfernrohr."

#: scripts/progression.gd
msgid "Six meters of area damage and 140% bonus damage against titans. Only twelve energy cells."
msgstr "Sechs Meter Flächenschaden und 140 % Zusatzschaden gegen Titanen. Nur zwölf Energiezellen."

#: scripts/progression.gd
msgid "First Flight"
msgstr "Erster Flug"

#: scripts/progression.gd
msgid "Use the drone station upstairs in the forest hut (key required). Fly 150 m and defeat 5 zombies with the Kestrel as a team, counted from accepting. E at the station, then Ready to fly. Space/Ctrl: climb/descend. RMB: rocket. R: self-destruct. Esc: return. Return to Mechanic for your reward."
msgstr "Benutzt die Drohnenstation im Obergeschoss der Waldhütte (Schlüssel erforderlich). Fliegt im Team 150 m und besiegt 5 Zombies mit der Kestrel, gezählt ab der Annahme. E an der Station, dann Ready to fly. Leertaste/Strg: steigen/sinken. RMT: Rakete. R: Selbstzerstörung. Esc: zurück. Hole danach deine Belohnung beim Mechanic ab."

#: scripts/progression.gd
msgid "Armed Patrol"
msgstr "Bewaffnete Patrouille"

#: scripts/progression.gd
msgid "Fly 400 m and defeat 15 zombies with the Viper as a team. Available when wave 10 starts. Earlier flights this round count. Return to Mechanic for your reward."
msgstr "Fliegt im Team 400 m und besiegt 15 Zombies mit der Viper. Verfügbar ab Beginn von Welle 10. Frühere Flüge dieser Runde zählen mit. Hole danach deine Belohnung beim Mechanic ab."

#: scripts/progression.gd
msgid "Heavy Air Support"
msgstr "Schwere Luftunterstützung"

#: scripts/progression.gd
msgid "Fly 600 m and defeat 30 zombies with the Tempest as a team. Available when wave 15 starts. Earlier flights this round count. Return to Mechanic for your reward."
msgstr "Fliegt im Team 600 m und besiegt 30 Zombies mit der Tempest. Verfügbar ab Beginn von Welle 15. Frühere Flüge dieser Runde zählen mit. Hole danach deine Belohnung beim Mechanic ab."

#: scripts/progression.gd
msgid "What the Forest Gives Us"
msgstr "Was der Wald uns gibt"

#: scripts/progression.gd
msgid "Collect five porcini as a team. Mara shows you what to look out for in the forest. Mushrooms you already collected count, and you may keep them."
msgstr "Sammelt als Team fünf Steinpilze. Mara zeigt euch, worauf man im Wald achten muss. Bereits gesammelte Pilze zählen; ihr dürft sie behalten."

#: scripts/progression.gd
msgid "Unrest on the Paths"
msgstr "Unruhe auf den Wegen"

#: scripts/progression.gd
msgid "Defeat twelve runners as a team. Their quick footsteps give nobody any rest, not even here by the small fire."
msgstr "Besiegt als Team zwölf Läufer. Ihre schnellen Schritte lassen selbst hier am kleinen Feuer niemanden zur Ruhe kommen."

#: scripts/progression.gd
msgid "While the Fire Burns"
msgstr "Solange das Feuer brennt"

#: scripts/progression.gd
msgid "Survive wave 6 and defeat 80 zombies in total. Then return to Mara at the small fire pit."
msgstr "Übersteht Welle 6 und besiegt insgesamt 80 Zombies. Kehre danach zu Mara an die kleine Feuerstelle zurück."

#: scripts/progression.gd
msgid "The Box at the Pond"
msgstr "Die Kiste am Teich"

#: scripts/progression.gd
msgid "Mara hid a box of supplies at the pond up in the forest before the first night. Find it at the shore and open it. The map marks the pond once you accept."
msgstr "Mara hat vor der ersten Nacht eine Kiste mit Vorräten am Teich oben im Wald versteckt. Finde sie am Ufer und öffne sie. Die Karte markiert den Teich, sobald du annimmst."

#: scripts/progression.gd
msgid "The Strange Mushroom"
msgstr "Der seltsame Pilz"

#: scripts/progression.gd
msgid "Somewhere in the forest grows a mushroom that glows violet at dusk. Find it and eat it right there. Mara warns you: the forest will look different for a while afterwards."
msgstr "Irgendwo im Wald wächst ein Pilz, der in der Dämmerung violett leuchtet. Finde ihn und iss ihn gleich dort. Mara warnt dich: Der Wald sieht danach eine Weile anders aus."

#: scripts/progression.gd
msgid "Into the Maize"
msgstr "Hinein ins Maisfeld"

#: scripts/progression.gd
msgid "A supply crate was left deep in the maize maze south of the hut path. Enter the maze, follow the cleared passages to the crate and open it. The map shows where it lies."
msgstr "Tief im Maislabyrinth südlich des Hüttenwegs wurde eine Vorratskiste zurückgelassen. Betritt das Labyrinth, folge den freigeschnittenen Gängen bis zur Kiste und öffne sie. Die Karte zeigt, wo sie liegt."

#: scripts/progression.gd
msgid "By the Fire"
msgstr "Am Feuer"

#: scripts/progression.gd
msgid "Vendor introduces you to the inventory, trading, tower building and barricades. Learn the basics, then collect your reward."
msgstr "Vendor führt dich in Inventar, Handel, Turmbau und Barrikaden ein. Lerne die Grundlagen und hole danach deine Belohnung ab."

#: scripts/progression.gd
msgid "The First Sentinel"
msgstr "Der erste Wächter"

#: scripts/progression.gd
msgid "Build a barricade and a tower. Then re-aim the tower. T: preview · R/mouse wheel: rotate · E: confirm. At the tower R: aim, E: climb in, F: repair."
msgstr "Baue eine Barrikade und einen Turm. Richte den Turm anschliessend neu aus. T: Vorschau · R/Mausrad: drehen · E: bestätigen. Am Turm R: ausrichten, E: einsteigen, F: reparieren."

#: scripts/progression.gd
msgid "Hold the Line"
msgstr "Die Linie halten"

#: scripts/progression.gd
msgid "Survive two waves as a team and defeat 30 zombies. Return to Vendor."
msgstr "Übersteht als Team zwei Wellen und besiegt 30 Zombies. Kehre zu Vendor zurück."

#: scripts/progression.gd
msgid "The Lost Delivery"
msgstr "Die verlorene Lieferung"

#: scripts/progression.gd
msgid "The toolbox got lost somewhere in the area. Where it lies changes every round and is marked on the map once you accept. Recover the delivery and return to Mechanic."
msgstr "Die Werkzeugkiste ist irgendwo im Gebiet verloren gegangen. Ihr Fundort wechselt mit jeder Runde und ist nach Annahme auf der Karte markiert. Berge die Lieferung und kehre zu Mechanic zurück."

#: scripts/progression.gd
msgid "What Lurks in the Field"
msgstr "Was auf dem Feld lauert"

#: scripts/progression.gd
msgid "Defeat a field titan together. They appear from wave 6. Then collect your reward from the Secret Vendor."
msgstr "Besiegt gemeinsam einen Feldtitanen. Sie erscheinen ab Welle 6. Hole danach deine Belohnung beim Secret Vendor ab."

#: scripts/progression.gd
msgid "A Steady Hand"
msgstr "Eine ruhige Hand"

#: scripts/progression.gd
msgid "Kill 15 zombies with headshots as a team. Every well-aimed hit saves supplies."
msgstr "Besiegt als Team 15 Zombies mit Kopfschüssen. Jeder gezielte Treffer spart Vorräte."

#: scripts/progression.gd
msgid "Precision Under Pressure"
msgstr "Präzision unter Druck"

#: scripts/progression.gd
msgid "Get 25 headshot kills as a team and survive wave 3. Pistol and revolver are enough. Then Vendor sends you to the final test with the Secret Vendor."
msgstr "Erreicht als Team 25 Kopfschuss-Kills und übersteht Welle 3. Pistole und Revolver genügen. Danach schickt dich Vendor zur Abschlussprüfung beim Secret Vendor."

#: scripts/progression.gd
msgid "The Long Shift"
msgstr "Die lange Schicht"

#: scripts/progression.gd
msgid "Survive wave 4 as a team. Vendor needs people who stay on after the first onslaught."
msgstr "Übersteht als Team Welle 4. Vendor braucht Leute, die auch nach dem ersten Ansturm bleiben."

#: scripts/progression.gd
msgid "The Last Light"
msgstr "Das letzte Licht"

#: scripts/progression.gd
msgid "Survive wave 8 and defeat 150 zombies in total. Keep the camp alive."
msgstr "Übersteht Welle 8 und besiegt insgesamt 150 Zombies. Haltet das Lager am Leben."

#: scripts/progression.gd
msgid "Crossfire"
msgstr "Kreuzfeuer"

#: scripts/progression.gd
msgid "Have two active gun turrets standing at the same time. Both must still stand when you turn in."
msgstr "Stellt zwei aktive Geschütztürme gleichzeitig auf. Beide müssen bei der Abgabe noch stehen."

#: scripts/progression.gd
msgid "Better Safe Than Sorry"
msgstr "Doppelt hält besser"

#: scripts/progression.gd
msgid "Reinforce two barricades to at least tier 2. Keep both standing until you turn in."
msgstr "Verstärkt zwei Barrikaden auf mindestens Stufe 2. Erhaltet beide bis zur Abgabe."

#: scripts/progression.gd
msgid "Like Clockwork"
msgstr "Wie ein Uhrwerk"

#: scripts/progression.gd
msgid "Upgrade a gun turret to tier 3 and let your towers defeat 40 zombies in total. The upgraded tower must still be standing."
msgstr "Baut einen Geschützturm auf Stufe 3 aus und lasst eure Türme insgesamt 40 Zombies besiegen. Der ausgebaute Turm muss noch stehen."

#: scripts/progression.gd
msgid "A Discreet Job"
msgstr "Ein diskreter Auftrag"

#: scripts/progression.gd
msgid "Get 40 headshot kills as a team. Collect your Marksman permit from the Secret Vendor. It allows you to buy precision rifles; waves, extra quests and the price still apply."
msgstr "Erreicht als Team 40 Kopfschuss-Kills. Hole deine Marksman-Berechtigung beim Secret Vendor ab. Sie erlaubt den Kauf von Präzisionsgewehren; Wellen, Zusatzaufträge und Kaufpreis gelten weiterhin."

#: scripts/progression.gd
msgid "The Giants' Debt"
msgstr "Die Schuld der Riesen"

#: scripts/progression.gd
msgid "Defeat three field titans in total. Some debts can only be paid with courage."
msgstr "Besiegt insgesamt drei Feldtitanen. Manche Schulden lassen sich nur mit Mut begleichen."

#: scripts/progression.gd
msgid "A Name No One Knows"
msgstr "Ein Name, den keiner kennt"

#: scripts/progression.gd
msgid "Survive wave 12 and defeat five field titans in total. After that we speak as equals."
msgstr "Übersteht Welle 12 und besiegt insgesamt fünf Feldtitanen. Danach sprechen wir als Gleichgestellte."

#: scripts/progression.gd
msgid "Arrival"
msgstr "Ankunft"

#: scripts/progression.gd
msgid "Assault"
msgstr "Sturm"

#: scripts/progression.gd
msgid "Marksman"
msgstr "Marksman"

#: scripts/progression.gd
msgid "Defense Engineering"
msgstr "Verteidigungstechnik"

#: scripts/progression.gd
msgid "Forest Watch"
msgstr "Waldwache"

#: scripts/progression.gd
msgid "Supply"
msgstr "Versorgung"

#: scripts/progression.gd
msgid "Titan Hunt"
msgstr "Titanenjagd"

#: scripts/progression.gd
msgid "Protect the Camp"
msgstr "Das Lager bewahren"

#: scripts/progression.gd
msgid "Drone Operations"
msgstr "Drohneneinsätze"

#: scripts/progression.gd
msgid "Zombies"
msgstr "Zombies"

#: scripts/progression.gd
msgid "Porcini mushrooms"
msgstr "Steinpilze"

#: scripts/progression.gd
msgid "Runners"
msgstr "Läufer"

#: scripts/progression.gd
msgid "Headshot kills"
msgstr "Kopfschuss-Kills"

#: scripts/progression.gd
msgid "Waves"
msgstr "Wellen"

#: scripts/progression.gd
msgid "Active towers"
msgstr "Aktive Türme"

#: scripts/progression.gd
msgid "Barricades tier 2+"
msgstr "Barrikaden Stufe 2+"

#: scripts/progression.gd
msgid "Towers tier 3"
msgstr "Türme Stufe 3"

#: scripts/progression.gd
msgid "Tower kills"
msgstr "Turm-Kills"

#: scripts/progression.gd
msgid "Kestrel flight (m)"
msgstr "Kestrel-Flugstrecke (m)"

#: scripts/progression.gd
msgid "Kestrel kills"
msgstr "Kestrel-Abschüsse"

#: scripts/progression.gd
msgid "Viper flight (m)"
msgstr "Viper-Flugstrecke (m)"

#: scripts/progression.gd
msgid "Viper kills"
msgstr "Viper-Abschüsse"

#: scripts/progression.gd
msgid "Tempest flight (m)"
msgstr "Tempest-Flugstrecke (m)"

#: scripts/progression.gd
msgid "Tempest kills"
msgstr "Tempest-Abschüsse"

#: scripts/progression.gd
msgid "Supply box at the pond"
msgstr "Vorratskiste am Teich"

#: scripts/progression.gd
msgid "Strange mushroom eaten"
msgstr "Seltsamer Pilz gegessen"

#: scripts/progression.gd
msgid "Crate in the maize maze"
msgstr "Kiste im Maislabyrinth"

#: scripts/progression.gd
msgid "[E] Open Mara's supply box"
msgstr "[E] Maras Vorratskiste öffnen"

#: scripts/progression.gd
msgid "SUPPLY BOX · MARA"
msgstr "VORRATSKISTE · MARA"

#: scripts/progression.gd
msgid "Supply box opened: bandages and cartridges. Return to Mara."
msgstr "Vorratskiste geöffnet: Verbandszeug und Patronen. Kehr zu Mara zurück."

#: scripts/progression.gd
msgid "[E] Eat the violet mushroom"
msgstr "[E] Den violetten Pilz essen"

#: scripts/progression.gd
msgid "STRANGE MUSHROOM"
msgstr "SELTSAMER PILZ"

#: scripts/progression.gd
msgid "You eat the mushroom. The forest begins to swim ..."
msgstr "Du isst den Pilz. Der Wald beginnt zu schwimmen ..."

#: scripts/progression.gd
msgid "[E] Open the supply crate"
msgstr "[E] Die Vorratskiste öffnen"

#: scripts/progression.gd
msgid "SUPPLY CRATE · MARA"
msgstr "VORRATSKISTE · MARA"

#: scripts/progression.gd
msgid "Crate opened: ammunition for everyone. Find your way back out and return to Mara."
msgstr "Kiste geöffnet: Munition für alle. Finde den Weg zurück hinaus und kehr zu Mara zurück."

#: scripts/progression.gd
msgid "Forest Camo"
msgstr "Waldtarn"

#: scripts/progression.gd
msgid "Moss, olive and dark earth. Purely cosmetic."
msgstr "Moos, Oliv und dunkle Erde. Rein optisch."

#: scripts/progression.gd
msgid "Soot Bronze"
msgstr "Russbronze"

#: scripts/progression.gd
msgid "Blackened metal with bronze panels. Purely cosmetic."
msgstr "Geschwärztes Metall mit bronzenen Flächen. Rein optisch."

#: scripts/progression.gd
msgid "Titan Bone"
msgstr "Titanenknochen"

#: scripts/progression.gd
msgid "Pale bone stripes on dark steel. Purely cosmetic."
msgstr "Helle Knochenstreifen auf dunklem Stahl. Rein optisch."

#: scripts/progression.gd
msgid "Trade"
msgstr "Handel"

#: scripts/progression.gd
msgid "Meet Vendor"
msgstr "Vendor kennenlernen"

#: scripts/progression.gd
msgid "Build a tower"
msgstr "Turm bauen"

#: scripts/progression.gd
msgid "Aim a tower"
msgstr "Turm ausrichten"

#: scripts/progression.gd
msgid "Build a barricade"
msgstr "Barrikade bauen"

#: scripts/progression.gd
msgid "Recover the delivery"
msgstr "Lieferung bergen"

#: scripts/progression.gd
msgid "DELIVERY · MECHANIC"
msgstr "LIEFERUNG · MECHANIC"

#: scripts/progression.gd
msgid "“%s” from %s"
msgstr "„%s“ bei %s"

#: scripts/progression.gd
msgid "accept"
msgstr "annehmen"

#: scripts/progression.gd
msgid "unlocks at mission level %d (currently %d)"
msgstr "ab Einsatzlevel %d (aktuell %d)"

#: scripts/progression.gd
msgid "available from wave %d"
msgstr "ab Welle %d verfügbar"

#: scripts/progression.gd
msgid "collect reward"
msgstr "Belohnung abholen"

#: scripts/progression.gd
msgid "finish: %s"
msgstr "abschliessen: %s"

#: scripts/progression.gd
msgid "Missing quest: %s."
msgstr "Fehlender Auftrag: %s."

#: scripts/progression.gd
msgid "Missing quest: %s. Next step: %s."
msgstr "Fehlender Auftrag: %s. Nächster Schritt: %s."

#: scripts/progression.gd
msgid "Quest line %s · %d/%d turned in"
msgstr "Questreihe %s · %d/%d abgegeben"

#: scripts/progression.gd
msgid "%s: purchase permit for %s. The price and extra conditions still apply."
msgstr "%s: Kaufberechtigung für %s. Kaufpreis und Zusatzbedingungen bleiben."

#: scripts/progression.gd
msgid "Unlocked"
msgstr "Freigeschaltet"

#: scripts/progression.gd
msgid "On completion"
msgstr "Reihenabschluss"

#: scripts/progression.gd
msgid "[E] Recover Mechanic's delivery"
msgstr "[E] Lieferung von Mechanic bergen"

#: scripts/progression.gd
msgid "[E] %s · %s"
msgstr "[E] %s · %s"

#: scripts/progression.gd
msgid "Mission level %d required (currently %d). Survive wave %d."
msgstr "Einsatzlevel %d erforderlich (aktuell %d). Überstehe Welle %d."

#: scripts/progression.gd
msgid "%d wave survived since accepting"
msgstr "%d Welle nach Annahme überstanden"

#: scripts/progression.gd
msgid "%d waves survived since accepting"
msgstr "%d Wellen nach Annahme überstanden"

#: scripts/progression.gd
msgid "After accepting: survive %d more wave(s)"
msgstr "Nach Annahme: noch %d Welle(n) überstehen"

#: scripts/progression.gd
msgid "Tower %d/1"
msgstr "Turm %d/1"

#: scripts/progression.gd
msgid "Aim %d/1"
msgstr "Ausrichten %d/1"

#: scripts/progression.gd
msgid "Build barricade %d/1"
msgstr "Barrikade bauen %d/1"

#: scripts/progression.gd
msgid "Waves %d/2"
msgstr "Wellen %d/2"

#: scripts/progression.gd
msgid "Zombies %d/30"
msgstr "Zombies %d/30"

#: scripts/progression.gd
msgid "Delivery recovered"
msgstr "Lieferung geborgen"

#: scripts/progression.gd
msgid "Search for the delivery at the map marker"
msgstr "Lieferung an der Kartenmarkierung suchen"

#: scripts/progression.gd
msgid "Titans %d/1"
msgstr "Titanen %d/1"

#: scripts/progression.gd
msgid "Meet Vendor at the campfire"
msgstr "Vendor am Lagerfeuer kennenlernen"

#: scripts/progression.gd
msgid "Permit missing: quest line %s. Next step: %s."
msgstr "Berechtigung fehlt: Questreihe %s. Nächster Schritt: %s."

#: scripts/progression.gd
msgid "Survive wave %d (%d/%d)"
msgstr "Welle %d überstehen (%d/%d)"

#: scripts/progression.gd
msgid "You can sell to Vendor and Secret Vendor."
msgstr "Verkaufen kannst du bei Vendor und Secret Vendor."

#: scripts/progression.gd
msgid "You don't have this meat."
msgstr "Dieses Fleisch besitzt du nicht."

#: scripts/progression.gd
msgid "You don't have this mushroom."
msgstr "Diesen Pilz besitzt du nicht."

#: scripts/progression.gd
msgid "No grenade in your inventory."
msgstr "Keine Granate im Inventar."

#: scripts/progression.gd
msgid "Hand grenade"
msgstr "Handgranate"

