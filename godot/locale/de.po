msgstr "[E] Den leuchtenden Pilz pflücken · %d / 3"

#: scripts/secret_night.gd
msgid "[E] Eat the DJ's mushroom · \"Trust me, forest spirit.\""
msgstr "[E] Den Pilz des DJ essen · \"Vertrau mir, Waldgeist.\""

#: scripts/secret_night.gd
msgid "[E] Drink Clear Head · water, mint and forest magic"
msgstr "[E] Klarer-Kopf-Trank trinken · Wasser, Minze und Waldmagie"

